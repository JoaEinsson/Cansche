{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@cansche/shared": ["packages/shared/src/index.ts"],
      "@cansche/domain": ["packages/domain/src/index.ts"],
      "@cansche/selection": ["packages/selection/src/index.ts"],
      "@cansche/engine": ["packages/engine/src/index.ts"],
      "@cansche/api": ["packages/api/src/index.ts"],
      "@cansche/storage": ["packages/storage/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
